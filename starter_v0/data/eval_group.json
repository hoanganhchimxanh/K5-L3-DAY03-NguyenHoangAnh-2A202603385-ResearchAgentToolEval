{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "Case do NHÓM tự viết thêm để cover thêm trường hợp. Mỗi case cần: id, phase='B', query HOẶC turns, failure_type (thuộc allowed_failure_types), và expect (tool_calls[...] hoặc no_tool=true). Nên kèm metadata.what_it_tests.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_hackernews_routing",
      "phase": "B",
      "suite": "group",
      "query": "Dân dev trên Hacker News đang bàn gì về Rust?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "hackernews",
            "args": {
              "query": "Rust"
            }
          }
        ]
      },
      "metadata": {
        "skill": "routing_new_tool_hackernews",
        "difficulty": "medium",
        "what_it_tests": "Dân dev / Hacker News bàn gì → tool mới hackernews (không phải lookup hay social_search); query chỉ là chủ đề."
      }
    },
    {
      "id": "G02_wikipedia_concept",
