          "role": "user",
          "content": "Thôi khoan, đừng đăng nữa"
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "no_tool": true,
        "behavior": "acknowledge_without_sending"
      },
      "metadata": {
        "skill": "multiturn_send_declined",
        "difficulty": "hard",
        "what_it_tests": "3 turns: agent đã hỏi xác nhận gửi Telegram, user từ chối → KHÔNG gọi send (và không gọi tool nào)."
